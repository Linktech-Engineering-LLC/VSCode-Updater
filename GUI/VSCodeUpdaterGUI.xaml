<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VSCode Updater"
    Height="900"
    Width="1300"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResize">

    <Grid Margin="15">

        <!-- ROW DEFINITIONS -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>     <!-- Row 1: Status + Task -->
            <RowDefinition Height="*"/>        <!-- Row 2: Buttons + DataGrid -->
            <RowDefinition Height="260"/>      <!-- Row 3: Command Window -->
            <RowDefinition Height="300"/>      <!-- Row 4: Log Viewer -->
        </Grid.RowDefinitions>

        <!-- COLUMN DEFINITIONS -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>    <!-- Column 1 -->
            <ColumnDefinition Width="260"/>    <!-- Column 2 -->
            <ColumnDefinition Width="*"/>      <!-- Column 3 -->
        </Grid.ColumnDefinitions>

        <!-- ===================================================== -->
        <!-- ROW 1: STATUS TEXT BOXES (COL 1–2) + TASK VIEWER (COL 3) -->
        <!-- ===================================================== -->

        <!-- STATUS FIELDS -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,20,0">
            <TextBlock x:Name="TxtStatus"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,12"/>

            <TextBox x:Name="TxtActiveVersion"  FontSize="13" Margin="0,0,0,4" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
            <TextBox x:Name="TxtSymlinkTarget"  FontSize="13" Margin="0,0,0,4" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
            <TextBox x:Name="TxtSymlinkValid"   FontSize="13" Margin="0,0,0,4" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
            <TextBox x:Name="TxtLastUpdate"     FontSize="13" Margin="0,0,0,4" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
            <TextBox x:Name="TxtFallbackReason" FontSize="13" Margin="0,0,0,4" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
        </StackPanel>

        <!-- TASK WINDOW -->
        <StackPanel Grid.Row="0" Grid.Column="2" Margin="10,0,0,0">
            <TextBlock Text="Task Viewer"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,6"/>
            <RichTextBox x:Name="TxtTaskViewer"
                         Height="220"
                         Background="#1E1E1E"
                         Foreground="White"
                         Padding="8"
                         VerticalScrollBarVisibility="Auto"
                         IsReadOnly="True"/>
        </StackPanel>

        <!-- ===================================================== -->
        <!-- ROW 2: ACTION BUTTONS (COL 1–2) + DATAGRID (COL 3) -->
        <!-- ===================================================== -->

        <!-- BUTTON COLUMN 1 -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,20,0">
            <Button x:Name="BtnUpdate"   Content="Update VS Code" Margin="0,0,0,10" Height="30" Padding="5,2"/>
            <Button x:Name="BtnRollback" Content="Rollback"       Margin="0,0,0,10" Height="30" Padding="5,2"/>
            <Button x:Name="BtnSwitch"   Content="Switch Version" Margin="0,0,0,10" Height="30" Padding="5,2"/>

            <Separator Margin="0,10,0,10"/>

            <Button x:Name="BtnValidateSymlink" Content="Validate Symlink" Margin="0,0,0,10" Height="30" Padding="5,2"/>
            <Button x:Name="BtnRestartSetup"    Content="Restart Setup"    Margin="0,0,0,10" Height="30" Padding="5,2"/>
        </StackPanel>

        <!-- BUTTON COLUMN 2 -->
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,20,0">
            <Button x:Name="BtnDashboard" Content="Open Dashboard" Margin="0,0,0,10" Height="30" Padding="5,2"/>
            <Button x:Name="BtnSafeMode"  Content="Run Safe Mode"  Margin="0,0,0,10" Height="30" Padding="5,2"/>

            <CheckBox x:Name="ChkSafeMode" Content="Safe Mode Enabled" Margin="0,10,0,0"/>

            <Separator Margin="0,10,0,10"/>

            <CheckBox x:Name="ChkAutoScroll" Content="Auto Scroll Log" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="TxtSearchLog" Width="150" Margin="0,0,10,0"/>
                <Button x:Name="BtnSearchLog" Content="Search Log" Width="80" Height="28"/>
            </StackPanel>
        </StackPanel>

        <!-- DATAGRID -->
        <DataGrid x:Name="DgVersions"
                  Grid.Row="1"
                  Grid.Column="2"
                  Margin="10,0,0,0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  Height="300">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Version"
                                    Binding="{Binding Name}"
                                    Width="150"/>
                <DataGridTextColumn Header="Path"
                                    Binding="{Binding FullName}"
                                    Width="*"/>
                <DataGridTextColumn Header="Last Modified"
                                    Binding="{Binding LastWriteTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                    Width="180"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ===================================================== -->
        <!-- ROW 3: COMMAND WINDOW (FULL WIDTH) -->
        <!-- ===================================================== -->

        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,10">
            <TextBlock Text="Command Output"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,6"/>
            <RichTextBox x:Name="TxtCommandOutput"
                         Background="#1E1E1E"
                         Foreground="White"
                         Padding="8"
                         VerticalScrollBarVisibility="Auto"
                         IsReadOnly="True"/>
        </StackPanel>

        <!-- ===================================================== -->
        <!-- ROW 4: LOG VIEWER (FULL WIDTH) -->
        <!-- ===================================================== -->

        <Grid Grid.Row="3" Grid.ColumnSpan="3" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- Log controls -->
                <RowDefinition Height="*"/>      <!-- Log viewer -->
            </Grid.RowDefinitions>

            <!-- LOG CONTROL BAR -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="BtnPauseLog" Content="Pause Log" Width="100" Height="30" Margin="0,0,10,0"/>
                <CheckBox x:Name="ChkAutoScrollLog" Content="Auto Scroll" Margin="0,0,20,0" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtSearchLogBar" Width="200" Height="25" Margin="0,0,10,0"/>
                <Button x:Name="BtnSearchLogBar" Content="Search" Width="80" Height="28"/>
            </StackPanel>

            <!-- LOG VIEWER -->
            <TextBox x:Name="TxtLog"
                     Grid.Row="1"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Padding="8"
                     IsReadOnly="True"/>
        </Grid>

    </Grid>
</Window>
